})

-- Logic Noclip xuyên tường
local noclipEnabled = false
local savedCollisions = {}

local function setCharacterCollision(char, canCollide)
	if not char then return end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			if not canCollide then
				if savedCollisions[part] == nil then
					savedCollisions[part] = part.CanCollide
				end
				part.CanCollide = false
			else
				if savedCollisions[part] ~= nil then
					part.CanCollide = savedCollisions[part]
				elseif part.Name ~= "HumanoidRootPart" then
					part.CanCollide = true
				end
			end
		end
	end
end

RunService.Stepped:Connect(function()
	if noclipEnabled and player.Character then
		setCharacterCollision(player.Character, false)
	end
end)

player.CharacterAdded:Connect(function(char)
	table.clear(savedCollisions)
	if noclipEnabled then
		task.wait(0.2)
		setCharacterCollision(char, false)
	end
end)

toggleBtn.MouseButton1Click:Connect(function()
	noclipEnabled = not noclipEnabled
	if noclipEnabled then
		toggleBtn.Text = "Noclip: ON"
		if player.Character then
			setCharacterCollision(player.Character, false)
		end
	else
		toggleBtn.Text = "Noclip: OFF"
		if player.Character then
			setCharacterCollision(player.Character, true)
		end
		table.clear(savedCollisions)
	end
end)

closeBtn.MouseButton1Click:Connect(function()
	noclipEnabled = false
	if player.Character then
		setCharacterCollision(player.Character, true)
	end
	noclipGui:Destroy()
end)

