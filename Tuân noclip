-- Hiệu ứng cầu vồng mượt mà
task.spawn(function()
	local hue = 0
	local elements = {noclipFrame, titleLabel, toggleBtn, closeBtn, minBtn, maxBtn}
	while noclipGui and noclipGui.Parent do
		hue = (hue + 0.004) % 1
		for idx, obj in ipairs(elements) do
			if obj and obj.Parent then
				local offsetHue = (hue + (idx * 0.09)) % 1
				obj.BackgroundColor3 = Color3.fromHSV(offsetHue, 0.85, 1)
			end
		end
		RunService.RenderStepped:Wait()
	end
end)

